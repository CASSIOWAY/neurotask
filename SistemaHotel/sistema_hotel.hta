<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>Sistema de Gestão Hoteleira</title>
<link rel="stylesheet" href="css\estilo.css">
<hta:application id="oSistema" applicationname="SistemaHotel" border="dialog" caption="yes" contextmenu="no" innerborder="no" maximizebutton="yes" minimizebutton="yes" navigable="no" scroll="auto" scrollflat="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes" version="1.0.0" windowstate="maximize" icon=""/>
<style>
    body { margin: 0; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; }
</style>
</head>
<body>
<div class="container">
    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>🏨 Pousada Encanto</h1>
            <div class="subtitle">Gestão Hoteleira - Carolina/MA</div>
        </div>
        <div class="sidebar-nav">
            <div class="nav-item ativo" data-modulo="dashboard" onclick="navegar('dashboard')">
                <span class="ico">📊</span><span>Dashboard</span>
            </div>
            <div class="nav-item" data-modulo="calendario" onclick="navegar('calendario')">
                <span class="ico">📅</span><span>Calendário</span>
            </div>
            <div class="nav-item" data-modulo="reservas" onclick="navegar('reservas')">
                <span class="ico">📋</span><span>Reservas</span>
                <span class="badge" id="badge-reservas">0</span>
            </div>
            <div class="nav-item" data-modulo="operacoes" onclick="navegar('operacoes')">
                <span class="ico">🔧</span><span>Operações</span>
            </div>
            <div class="nav-item" data-modulo="hospedes" onclick="navegar('hospedes')">
                <span class="ico">👥</span><span>Hóspedes</span>
            </div>
            <div class="nav-item" data-modulo="canais" onclick="navegar('canais')">
                <span class="ico">📡</span><span>Canais</span>
            </div>
            <div class="nav-item" data-modulo="financeiro" onclick="navegar('financeiro')">
                <span class="ico">💰</span><span>Fluxo de Caixa</span>
            </div>
            <div class="nav-item" data-modulo="analise" onclick="navegar('analise')">
                <span class="ico">📈</span><span>Análise</span>
            </div>
            <div class="nav-item" data-modulo="whatsapp" onclick="navegar('whatsapp')">
                <span class="ico">📱</span><span>WhatsApp</span>
            </div>
            <div class="nav-item" data-modulo="integracoes" onclick="navegar('integracoes')">
                <span class="ico">🔗</span><span>Integrações</span>
            </div>
            <div class="nav-item" data-modulo="config" onclick="navegar('config')">
                <span class="ico">⚙️</span><span>Configurações</span>
            </div>
        </div>
        <div class="sidebar-footer">
            Sistema de Gestão Hoteleira v1.0.0
        </div>
    </div>

    <!-- MAIN -->
    <div class="main">
        <div class="topbar">
            <h2 id="page-title">Painel de Controle</h2>
            <div class="info">
                <span class="data" id="data-atual"></span>
                <span>|</span>
                <span>🏨 Pousada Encanto da Chapada</span>
            </div>
        </div>
        <div class="content" id="conteudo-principal">
            <div class="loading">
                <div class="spin"></div>
                <p style="margin-top: 10px;">Carregando sistema...</p>
            </div>
        </div>
    </div>
</div>

<script language="javascript" src="js\app.js"></script>
<script language="javascript">
    // Atualiza badge de reservas pendentes
    function atualizarBadge() {
        try {
            var shell = new ActiveXObject('WScript.Shell');
            var cmd = 'powershell.exe -ExecutionPolicy Bypass -File "' + BASE_DIR + '\\modules\\controller.ps1" -Modulo reservas -Acao estatisticas';
            var exec = shell.Exec(cmd);
            var resultado = '';
            while (!exec.StdOut.AtEndOfStream) { resultado += exec.StdOut.ReadAll(); }
            var dados = JSON.parse(resultado.trim());
            var total = (dados.pendentes || 0) + (dados.confirmadas || 0);
            var el = document.getElementById('badge-reservas');
            if (el) {
                el.textContent = total;
                el.style.display = total > 0 ? 'inline' : 'none';
            }
        } catch(e) {}
    }

    // Atualizar a cada 30 segundos
    setInterval(atualizarBadge, 30000);
    setTimeout(atualizarBadge, 2000);
</script>
</body>
</html>
